# ANTHROPIC_API_KEY=

# docker-compose.yml interpolates ANTHROPIC_API_KEY (passed to the worker
# service only -- it's the sole container that calls the model) from a
# repo-root .env, which is gitignored, or from the host environment.
#
# Shortcut: `Copy-Item backend\.env .env` works fine here -- compose only
# reads ANTHROPIC_API_KEY out of the root .env, so the extra
# backend-specific DATABASE_URL line in that file is simply ignored.
