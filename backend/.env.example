ANTHROPIC_API_KEY=
# The application connects as the runtime role (a member of docpilot_app), which
# row-level security binds: the API, the worker, and the stdio MCP server refuse
# to start as a role that is a superuser, has BYPASSRLS, or owns the tables
# (app/db.py verify_tenant_isolation). `docker compose up` creates this role
# (docpilot_runtime, dev-grade credentials like the owner's).
DATABASE_URL=postgresql+asyncpg://docpilot_runtime:docpilot_runtime@localhost:5434/docpilot
# The database owner, for Alembic and scripts/provision_db_role.py only. Run
# `alembic upgrade head && python scripts/provision_db_role.py` on the host with
# it set; the application never connects as the owner.
MIGRATION_DATABASE_URL=postgresql+asyncpg://docpilot:docpilot@localhost:5434/docpilot

# Optional overrides (defaults shown) - uncomment to change.
# EXTRACTION_MODEL=claude-sonnet-5
# REVIEW_THRESHOLD=0.8
# EXTRACTION_PROMPT_VERSION=extract_v1
# DAILY_BUDGET_USD=5
# ORGANIZATION_DAILY_BUDGET_USD=0
# SESSION_COOKIE_NAME=docpilot_session
# SESSION_COOKIE_SECURE=false
# SESSION_TTL_HOURS=12
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# LOGIN_ACCOUNT_RATE_LIMIT_PER_MINUTE=5
