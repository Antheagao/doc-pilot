# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.hypothesis/
.ruff_cache/
*.egg-info/
build/
dist/

# Env
.env

# App
uploads/

# Node / frontend
node_modules/
.next/

# OS cruft
.DS_Store
Thumbs.db

# Terraform (infra/terraform): provider downloads, state and variable
# files hold machine-local or sensitive values. The lock file is committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Demo recordings (scripts/demos): WebM/MP4/poster pairs; the GIFs under
# screenshots/features/ are the committed artifacts.
scripts/demos/out/

# Load-test run data (scripts/load): the seeded tenants' API keys and
# passwords (tenants.json) and raw samples. Never committed; the artifacts
# under scripts/load/results/ are.
scripts/load/out/
# Raw per-request samples written beside a run's artifact; the artifact
# keeps the quantiles, and the samples are too large to commit.
scripts/load/results/samples/
